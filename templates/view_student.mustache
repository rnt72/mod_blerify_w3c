{{!
    @template mod_blerify/view_student

    Learner view: the issued certificate, plus claiming it into a wallet.
}}
<div class="mod-blerify-student">
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            {{#not_yet}}
                <div class="alert alert-info mb-0">
                    <strong>{{#str}}certificate_not_yet, blerify{{/str}}</strong>
                    <p class="mb-0 mt-2">{{#str}}certificate_threshold, blerify{{/str}} {{ passgrade }}%</p>
                    {{#current_grade}}
                        <p class="mb-0"><small>{{#str}}certificate_current_grade, blerify{{/str}} {{ current_grade }}%</small></p>
                    {{/current_grade}}
                </div>
            {{/not_yet}}

            {{#is_processing}}
                <div class="alert alert-info mb-0 d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm mr-2" role="status"></div>
                    <span>{{#str}}certificate_processing, blerify{{/str}}</span>
                </div>
            {{/is_processing}}

            {{#is_error}}
                <div class="alert alert-danger mb-0">
                    <strong>{{#str}}certificate_error, blerify{{/str}}</strong>
                </div>
            {{/is_error}}

            {{#is_ready}}
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-3" style="gap:8px;">
                    <div>
                        <h4 class="mb-1">{{ activityname }}</h4>
                        {{#templatename}}<small class="text-muted">{{ templatename }}</small>{{/templatename}}
                    </div>
                    {{#is_claimed}}
                        <span class="badge badge-success p-2">{{#str}}status_claimed, blerify{{/str}}</span>
                    {{/is_claimed}}
                    {{^is_claimed}}
                        <span class="badge badge-info p-2">{{#str}}status_issued, blerify{{/str}}</span>
                    {{/is_claimed}}
                </div>

                <div class="mb-3" style="border:1px solid #dee2e6;border-radius:8px;overflow:hidden;">
                    <object data="{{ pdf_url }}" type="application/pdf" width="100%" height="620">
                        <div class="p-4 text-center">
                            <p>{{#str}}pdf_inline_unavailable, blerify{{/str}}</p>
                            <a href="{{ pdf_url }}" target="_blank" rel="noopener" class="btn btn-outline-primary">
                                {{#str}}pdf_open, blerify{{/str}}
                            </a>
                        </div>
                    </object>
                </div>

                <div class="d-flex flex-wrap justify-content-center" style="gap:12px;">
                    <a href="{{ download_url }}" class="btn btn-outline-primary">
                        {{#str}}pdf_download, blerify{{/str}}
                    </a>
                    {{#show_claim}}
                        {{^claim_requested}}
                            <a href="{{ claim_url }}" class="btn btn-primary">
                                {{#str}}claim_btn, blerify{{/str}}
                            </a>
                        {{/claim_requested}}
                    {{/show_claim}}
                </div>
            {{/is_ready}}

        </div>

        {{#qr_data_url}}
            <div class="card-footer text-center">
                <p class="mb-2" style="font-size:1.05em;font-weight:600;">{{#str}}claim_scan_prompt, blerify{{/str}}</p>

                <img src="{{ qr_data_url }}" alt="QR" width="260" height="260"
                     style="display:block;margin:0 auto;image-rendering:pixelated;" />

                <p class="mt-3 mb-2"><small>{{#str}}claim_or_open_link, blerify{{/str}}</small></p>
                <a href="{{ deeplink_url }}" class="btn btn-sm btn-outline-secondary mb-3" rel="noopener">
                    {{#str}}claim_open_wallet, blerify{{/str}}
                </a>

                <p class="mb-2" style="font-size:.9em;">{{#str}}wallet_download_prompt, blerify{{/str}}</p>
                <div class="d-flex justify-content-center align-items-center flex-wrap" style="gap:16px;">
                    <a href="{{ appstore_url }}" target="_blank" rel="noopener">
                        <img src="{{ appstore_img }}" alt="{{#str}}wallet_download_ios, blerify{{/str}}" height="54" />
                    </a>
                    <a href="{{ playstore_url }}" target="_blank" rel="noopener">
                        <img src="{{ playstore_img }}" alt="{{#str}}wallet_download_android, blerify{{/str}}" height="54" />
                    </a>
                </div>
            </div>
        {{/qr_data_url}}
    </div>
</div>
